<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/settings_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_description"
            android:padding="14dp"
            android:src="@drawable/ic_back" />
        <ImageButton
            android:id="@+id/settings_announcement"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/announcement_title"
            android:padding="14dp"
            android:src="@drawable/ic_announcement" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/video_retention_choice"
            android:text="@string/video_retention_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/input_background"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Spinner
                android:id="@+id/video_retention_choice"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/accent"
                android:entries="@array/video_retention_options"
                android:spinnerMode="dropdown" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/batch_preview_toggle"
                android:text="@string/batch_preview_setting"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
            <Switch
                android:id="@+id/batch_preview_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:showText="true"
                android:textOff="@string/switch_off"
                android:textOn="@string/switch_on" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/batch_clear_on_return_toggle"
                android:text="@string/batch_clear_on_return_setting"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
            <Switch
                android:id="@+id/batch_clear_on_return_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:showText="true"
                android:textOff="@string/switch_off"
                android:textOn="@string/switch_on" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/batch_selection_choice"
            android:text="@string/batch_selection_setting"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
        <Button
            android:id="@+id/batch_selection_choice"
            style="@style/InputGridButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_background"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:drawableEnd="@drawable/ic_dropdown"
            android:drawablePadding="8dp"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/douyin_browser_toggle"
                android:text="@string/douyin_browser_setting"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
            <Switch
                android:id="@+id/douyin_browser_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:showText="true"
                android:textOff="@string/switch_off"
                android:textOn="@string/switch_on" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/batch_parse_toggle"
                android:text="@string/batch_parse_setting"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
            <Switch
                android:id="@+id/batch_parse_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:showText="true"
                android:textOff="@string/switch_off"
                android:textOn="@string/switch_on" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/batch_reparse_toggle"
                android:text="@string/batch_reparse_setting"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
            <Switch
                android:id="@+id/batch_reparse_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:showText="true"
                android:textOff="@string/switch_off"
                android:textOn="@string/switch_on" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/batch_clear_toggle"
                android:text="@string/batch_clear_setting"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
            <Switch
                android:id="@+id/batch_clear_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:showText="true"
                android:textOff="@string/switch_off"
                android:textOn="@string/switch_on" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
