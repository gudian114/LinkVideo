<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/update_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/update_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
        <ImageButton
            android:id="@+id/update_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_description"
            android:padding="14dp"
            android:src="@drawable/ic_back" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:id="@+id/update_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_checking"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/update_current_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/update_current_version_unknown"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/update_latest_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/update_package_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/update_release_notes_label"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/update_release_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="80dp"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="15sp" />
            <ProgressBar
                android:id="@+id/update_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:indeterminate="true" />
            <TextView
                android:id="@+id/update_progress_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
            <Button
                android:id="@+id/update_primary"
                style="@style/InputBlueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/update_download"
                android:visibility="gone" />
            <Button
                android:id="@+id/update_secondary"
                style="@style/InputRedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/update_cancel"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
