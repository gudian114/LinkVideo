<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="18dp">
    <TextView
        android:id="@+id/batch_entry_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/batch_input"
        android:text="@string/input_label"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />
    <CheckBox
        android:id="@+id/batch_select_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="gone" />
    <com.linkvideo.parser.BatchLinkInput
        android:id="@+id/batch_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/input_background"
        android:gravity="top|start"
        android:hint="@string/input_hint"
        android:imeOptions="actionNone"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:maxLength="16000"
        android:maxLines="6"
        android:minLines="3"
        android:padding="12dp"
        android:saveEnabled="false"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="16sp" />
    <LinearLayout
        android:id="@+id/batch_entry_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />
    <TextView
        android:id="@+id/batch_entry_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
    <Button
        android:id="@+id/batch_error_details"
        style="@style/InputBlueButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/view_error_details"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/batch_entry_progress_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">
        <ProgressBar
            android:id="@+id/batch_entry_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progressTint="@color/accent" />
        <TextView
            android:id="@+id/batch_entry_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>
    <CheckBox
        android:id="@+id/batch_select_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/batch_video_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />
    <TextView
        android:id="@+id/batch_entry_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="16sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/batch_entry_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
